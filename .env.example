DB_NAME=flux_panel
DB_USER=flux_panel
DB_PASSWORD=replace_with_a_long_random_password
JWT_SECRET=replace_with_a_different_long_random_secret
# Use mysql:5.7 on amd64 and mysql:8.0 on arm64.
MYSQL_IMAGE=mysql:5.7
IMAGE_REGISTRY=ghcr.io/norwayxz
PANEL_VERSION=2.51.43
BACKEND_HEALTH_START_PERIOD=420s
BACKEND_HEALTH_RETRIES=6
MONITORING_SCAN_INTERVAL_MS=30000
MONITORING_RETENTION_DAYS=90
FORWARD_HEALTH_CHECK_INTERVAL_MS=60000
FORWARD_FAILURE_THRESHOLD=2
FORWARD_RECOVERY_THRESHOLD=2
FORWARD_SWITCH_COOLDOWN_MS=120000
FORWARD_FAILBACK_STABLE_MS=180000
FORWARD_LATENCY_SWITCH_GAP_MS=15
AUTO_UPDATE_ENABLED=1
FRONTEND_PORT=6366
BACKEND_PORT=6365
JAVA_OPTS="-Xms192m -Xmx512m -XX:+UseG1GC -XX:+ExitOnOutOfMemoryError -Dfile.encoding=UTF-8 -Duser.timezone=Asia/Shanghai"
DB_POOL_MIN_IDLE=1
DB_POOL_MAX_SIZE=10
TOMCAT_MIN_SPARE_THREADS=2
TOMCAT_MAX_THREADS=100
TOMCAT_MAX_CONNECTIONS=512
TOMCAT_ACCEPT_COUNT=100
MYSQL_MAX_CONNECTIONS=200
MYSQL_BUFFER_POOL_SIZE=128M
